{
  "name": "donde-es-la-vaina-api",
  "version": "1.0.0",
  "description": "REST API for the Donde Es La Vaina ticketing platform",
  "main": "server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "migrate:passwords": "node --env-file=.env scripts/migrate-passwords.js",
    "measure:hash": "node scripts/measure-hash-time.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.20.0",
    "swagger-ui-express": "^5.0.1"
  }
}
